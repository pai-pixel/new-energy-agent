# 新能源智能体 - 环境变量模板
# 本地开发: 复制为 .env 并填入真实值
# Colab 部署: 在侧边栏 Secrets 面板中配置

# DeepSeek API Key (必填)
# 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API 地址 (默认即可)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型 (默认 deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# ngrok Authtoken (可选，用于 Colab 部署时的公网访问)
NGROK_TOKEN=xxx
